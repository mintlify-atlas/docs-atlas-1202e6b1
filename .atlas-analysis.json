  "keyFeatures": [
    "Random word retrieval by letter count from a 57 000+ word Spanish dictionary",
    "Special Ignatian word mode (Jesuit-themed vocabulary)",
    "Word validation — checks whether a guessed word exists in the dictionary",
    "JWT-based stateless authentication with 3-hour token expiry",
    "User registration and login with BCrypt password hashing",
    "Point-accumulation system tied to authenticated users",
    "Top-3 leaderboard (podio) endpoint",
    "PostgreSQL persistence via Spring Data JPA",
    "Dockerfile for containerised deployment (Render-compatible)"
  ],
  "publicApiSurface": [
    "POST /auth/registro",
    "POST /auth/login",
    "GET /auth/credencialDisponible?usuario={nombre}",
    "GET /wordle/palabra/{numLetras}",
    "GET /wordle/palabraIgnaciana",
    "GET /wordle/palabraExiste/{palabra}",
    "POST /wordle/introducirPalabras",
    "GET /usuario/loggeado",
    "PUT /usuario/sumarPuntos/{puntos}",
    "GET /usuario/podio"
  ]
}
